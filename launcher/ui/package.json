{
  "name": "xhs-launcher-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "_build_note": "build 用 --base './' 因为 PyWebView 用 file:// 加载,绝对路径 /assets/... 解析失败。关联: docs/superpowers/specs/2026-08-17-launcher-ui-baseurl-pywebview-design.md",
    "build": "vue-tsc --noEmit && vite build --base './'",
    "build:fast": "vite build --base './'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.9.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
