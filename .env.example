# 本文件集中管理本地运行参数。修改后请重启相关服务使配置生效。
# 敏感信息只应保存在 .env；.env.example 仅保留安全示例或空值。

# =============================================================================
# 应用基础与安全
# 服务名称、运行环境、签名密钥和登录令牌有效期。
# =============================================================================
# APP_NAME：应用显示名称。
APP_NAME=小红书本地活动信息抓取系统

# APP_ENV：运行环境标识，例如 development、test 或 production。
APP_ENV=development

# SECRET_KEY：JWT 等安全功能使用的签名密钥；生产环境必须使用随机强密钥。
SECRET_KEY=replace-with-a-random-local-secret

# JWT_EXPIRE_HOURS：登录令牌有效时长，单位：小时。
JWT_EXPIRE_HOURS=24

# =============================================================================
# 管理员账号
# 首次 alembic upgrade head 播种 admin 用户时读取（migration 0012）。
# =============================================================================
# INITIAL_ADMIN_PASSWORD：admin 初始密码；仅首次建库播种时生效，缺省回退 Admin@123
# 并记 WARNING。生产/共享环境必须显式设置为强密码。用户名固定为 admin。
INITIAL_ADMIN_PASSWORD=

# =============================================================================
# 后端 API 与跨域
# FastAPI 地址、端口、路由前缀以及允许访问的前端来源。
# =============================================================================
# API_V1_PREFIX：后端 API 的统一路由前缀。
API_V1_PREFIX=/api/v1

# API_HOST：后端监听地址；127.0.0.1 表示仅本机可访问。
API_HOST=127.0.0.1

# API_PORT：后端监听端口。
API_PORT=8000

# CORS_ORIGINS：允许跨域访问 API 的前端地址，多个地址用英文逗号分隔。
# 默认包含 5173-5199 范围,适配启动器端口自适应。超出范围可在 .env 显式追加。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5180,http://127.0.0.1:5180,http://localhost:5181,http://127.0.0.1:5181,http://localhost:5182,http://127.0.0.1:5182,http://localhost:5183,http://127.0.0.1:5183,http://localhost:5184,http://127.0.0.1:5184,http://localhost:5185,http://127.0.0.1:5185,http://localhost:5186,http://127.0.0.1:5186,http://localhost:5187,http://127.0.0.1:5187,http://localhost:5188,http://127.0.0.1:5188,http://localhost:5189,http://127.0.0.1:5189,http://localhost:5190,http://127.0.0.1:5190,http://localhost:5191,http://127.0.0.1:5191,http://localhost:5192,http://127.0.0.1:5192,http://localhost:5193,http://127.0.0.1:5193,http://localhost:5194,http://127.0.0.1:5194,http://localhost:5195,http://127.0.0.1:5195,http://localhost:5196,http://127.0.0.1:5196,http://localhost:5197,http://127.0.0.1:5197,http://localhost:5198,http://127.0.0.1:5198,http://localhost:5199,http://127.0.0.1:5199

# API_BASE_URL：前端通过 __APP_CONFIG__ 读取的完整 API base URL(含 /api/v1 前缀)。
# 启动器启动时根据实际 API_PORT 自动写入;手动修改需保证与 API_PORT 一致。
# API_BASE_URL=http://127.0.0.1:8000/api/v1

# =============================================================================
# 前端开发服务
# Vue/Vite 本地服务及前端请求 API 的参数。
# =============================================================================
# WEB_HOST：前端开发服务器监听地址。
WEB_HOST=127.0.0.1

# WEB_PORT：前端服务监听端口。开发模式 vite dev 默认 5173;
# 打包版启动器启动后会从 5173 开始扫描并写回 .env(被占跳到 5174/5175...)。
WEB_PORT=5173

# VITE_API_BASE_URL：浏览器请求后端时使用的 API 基础路径。
# 开发模式(/api/v1 + vite proxy);生产模式 launcher 会注入 window.__APP_CONFIG__.apiBaseUrl。
VITE_API_BASE_URL=/api/v1

# VITE_API_TIMEOUT_MS：前端 API 请求超时时间，单位：毫秒。
VITE_API_TIMEOUT_MS=10000

# =============================================================================
# 数据库与本地文件
# SQLite、图片、导出文件、归档、备份及模型文件的保存位置。
#
# 【base dir 模式】用户只需要设 DATA_DIR 一个字段,其他子目录自动从 DATA_DIR 推导:
#   - IMAGE_DIR        = $DATA_DIR/images
#   - EXPORT_DIR       = $DATA_DIR/exports
#   - ARCHIVE_DIR      = $DATA_DIR/archive
#   - BACKUP_DIR       = $DATA_DIR/backups
#   - CELERY_FOLDER    = $DATA_DIR/celery
#   - TASK_REGISTRY_PATH = $DATA_DIR/run/task_registry.json
#   - TMP_DIR          = $DATA_DIR/tmp
#   - PADDLE_PDX_CACHE_HOME = $DATA_DIR/paddlex
#   - HF_HOME          = $DATA_DIR/huggingface
#   - CHROME_USER_DATA_DIR = $DATA_DIR/chrome-pool
#   - DATABASE_URL     = sqlite:///$DATA_DIR/app.db
#   - LOG_DIR          = $DATA_DIR/logs (launcher 自己用,需要单独设)
#
# 推荐:把 DATA_DIR 改到 .app 外部的绝对路径(避免升级 .app 时数据丢失),
# 比如 ~/Library/Application Support/com.xhs-info-crawl.local。
# 关联 spec: docs/superpowers/specs/2026-08-17-launcher-storage-base-dir-design.md
# =============================================================================
# DATABASE_URL：数据库连接地址;留空则自动从 DATA_DIR 拼 sqlite:///$DATA_DIR/app.db。
DATABASE_URL=

# DATA_DIR：运行数据根目录。
# base dir 模式:用户唯一需要配置的存储路径,其他子目录从这里自动推导。
# 启动器会自动把 DATA_DIR 写到 launcher UI 的"存储路径"面板,
# OCR 模型、数据库、图片、导出、归档等所有运行产物都在 DATA_DIR 下。
DATA_DIR=./data

# =============================================================================
# 活动日期校验
# 控制活动发生时间的有效范围，与小红书笔记发布时间筛选无关。
# =============================================================================
# ACTIVITY_FUTURE_WINDOW_DAYS：从任务首次开始日算起，最多保留未来多少天的活动。
ACTIVITY_FUTURE_WINDOW_DAYS=60

# =============================================================================
# Celery 任务队列
# 一期使用本地 filesystem broker，无需 Redis。
# =============================================================================
# CELERY_BROKER_URL：Celery 消息代理地址；filesystem:// 表示使用本地文件队列。
CELERY_BROKER_URL=filesystem://

# CELERY_TIMEZONE：Celery 定时任务使用的时区。
CELERY_TIMEZONE=Asia/Shanghai

# CELERY_WORKER_POOL：Worker 执行池；本地兼容模式使用 solo。
CELERY_WORKER_POOL=solo

# CELERY_WORKER_CONCURRENCY：单个 Worker 的并发任务数。
CELERY_WORKER_CONCURRENCY=1

# CELERY_LOG_LEVEL：Celery 日志级别，例如 INFO 或 DEBUG。
CELERY_LOG_LEVEL=INFO

# =============================================================================
# 定时任务与抓取批次
# 每周任务执行时间、抓取间隔和每批数据量。
# =============================================================================
# WEEKLY_CRAWL_DAY_OF_WEEK：每周抓取执行日；Celery crontab 中 0 表示周日、1 表示周一。
WEEKLY_CRAWL_DAY_OF_WEEK=1

# WEEKLY_CRAWL_HOUR：每周抓取执行小时，使用 24 小时制。
WEEKLY_CRAWL_HOUR=2

# WEEKLY_CRAWL_MINUTE：每周抓取执行分钟。
WEEKLY_CRAWL_MINUTE=0

# OPENCLI_BIN：opencli 可执行文件。默认按 PATH 解析；worker 重启环境 PATH 不可控时，
# 建议配置绝对路径（如 nvm 安装：~/.nvm/versions/node/<版本>/bin/opencli）。
OPENCLI_BIN=opencli

# SEARCH_INTERVAL_MIN：连续搜索操作的最小随机等待时间，单位：秒。
SEARCH_INTERVAL_MIN=10

# SEARCH_INTERVAL_MAX：连续搜索操作的最大随机等待时间，单位：秒。
SEARCH_INTERVAL_MAX=15

# SEARCH_LIMIT：普通单次搜索最多处理的笔记数量。
SEARCH_LIMIT=50

# WEEKLY_SEARCH_LIMIT：每周关键词搜索次数上限（按 search 调用计，超限后跳过剩余关键词搜索并记录 WARNING）。
WEEKLY_SEARCH_LIMIT=500

# CONSECUTIVE_NOTE_FAILURE_LIMIT：连续多少篇笔记处理失败后熔断任务为 PAUSED，
# 等待用户检查登录/验证后继续或结束；零星单篇失败不受影响。
CONSECUTIVE_NOTE_FAILURE_LIMIT=3

# =============================================================================
# 小红书浏览器与滚动策略
# 连接已登录浏览器，并控制搜索页及详情页的下拉次数。
# =============================================================================
# OPENCLI_CDP_ENDPOINT：已登录浏览器的 Chrome DevTools Protocol 地址。
OPENCLI_CDP_ENDPOINT=http://localhost:9222

# OPENCLI_BROWSER_COMMAND_TIMEOUT：opencli 单条浏览器命令超时时间，单位：秒；超过该时间会返回 exitCode 75。
OPENCLI_BROWSER_COMMAND_TIMEOUT=120

# XHS_LOGIN_URL：等待登录任务打开的固定小红书页面。
XHS_LOGIN_URL=https://www.xiaohongshu.com/explore

# XHS_LOGIN_BROWSER：本地登录时唤醒的浏览器名称；OpenCLI 复用该 Chrome 登录态。
XHS_LOGIN_BROWSER=Google Chrome

# XHS_SEARCH_TARGET_COUNT：搜索页期望收集的笔记数量。
XHS_SEARCH_TARGET_COUNT=50

# XHS_SEARCH_SCROLL_MAX_ROUNDS：搜索结果页最多下拉轮数。
XHS_SEARCH_SCROLL_MAX_ROUNDS=8

# XHS_DETAIL_SCROLL_MAX_ROUNDS：单篇笔记详情页最多下拉轮数。
XHS_DETAIL_SCROLL_MAX_ROUNDS=8

# XHS_SCROLL_PIXELS：每次页面下拉的像素数。
XHS_SCROLL_PIXELS=800

# XHS_SCROLL_STAGNANT_ROUNDS：连续多少轮没有新内容后停止下拉。
XHS_SCROLL_STAGNANT_ROUNDS=2

# =============================================================================
# 单笔记流水线重试
# 详情、下载、OCR 和模型提取的最大尝试次数与重试间隔。
# =============================================================================
# PIPELINE_STAGE_MAX_RETRIES：每个处理阶段最多尝试次数，包含第一次执行。
PIPELINE_STAGE_MAX_RETRIES=2

# PIPELINE_STAGE_RETRY_DELAY_SECONDS：阶段失败后的等待时间，单位：秒。
PIPELINE_STAGE_RETRY_DELAY_SECONDS=2

# =============================================================================
# LLM 活动识别模型
# 用于从笔记文字和图片识别结构化活动信息。
# 字段名为历史遗留,实际支持任意 OpenAI 兼容协议(provider 可在 launcher UI 选择)。
# =============================================================================
# MINIMAX_API_KEY：LLM API 密钥；只写入本地 .env，不要提交到 Git。
MINIMAX_API_KEY=

# MINIMAX_BASE_URL：LLM API 服务基础地址(默认空,启动器 UI 选择 provider 后写入)。
MINIMAX_BASE_URL=

# MINIMAX_MODEL：活动识别使用的模型名称(默认空,启动器 UI 选择 provider 后写入)。
MINIMAX_MODEL=

# MINIMAX_VISION_MODEL：图片理解(视觉)使用的模型名称;留空表示走文本模型不调视觉。
MINIMAX_VISION_MODEL=

# MINIMAX_CHAT_PATH：LLM 文本对话接口路径(OpenAI 兼容默认 /chat/completions)。
MINIMAX_CHAT_PATH=/chat/completions

# MINIMAX_TIMEOUT_SECONDS：单次 LLM API 请求超时时间，单位：秒。
MINIMAX_TIMEOUT_SECONDS=180

# MINIMAX_CONCURRENCY：LLM API 并发调用数（1-4，默认 1=串行）。
# 小范围并行避免 429/529 限流雪崩；调高时注意 API 配额。
MINIMAX_CONCURRENCY=1

# =============================================================================
# PaddleOCR
# 本地图片文字识别开关、语言及图像预处理参数。
# =============================================================================
# OCR_ENABLED：是否启用 PaddleOCR；true 启用，false 关闭。
OCR_ENABLED=false

# OCR_LANGUAGE：OCR 识别语言；ch 表示中英文。
OCR_LANGUAGE=ch

# OCR_MIN_CONFIDENCE：OCR 文本最低置信度，范围 0 到 1。
OCR_MIN_CONFIDENCE=0.5

# OCR_USE_DOC_ORIENTATION_CLASSIFY：是否启用文档方向分类。
OCR_USE_DOC_ORIENTATION_CLASSIFY=false

# OCR_USE_DOC_UNWARPING：是否启用文档图像矫正。
OCR_USE_DOC_UNWARPING=false

# OCR_USE_TEXTLINE_ORIENTATION：是否启用文本行方向分类。
OCR_USE_TEXTLINE_ORIENTATION=false

# OCR_PARALLEL_WORKERS：笔记内图片并行 OCR 线程数（1-4，默认 2）。
# 本地 PaddleOCR 模型，不占网络带宽，仅占用 CPU；单例 predict 线程安全。
OCR_PARALLEL_WORKERS=2
